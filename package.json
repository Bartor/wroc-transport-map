{
  "name": "wroc-transport-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "etl": "python etl/build.py",
    "build:public": "vite build --mode public",
    "preview:public": "vite build --mode public && vite preview",
    "test": "vitest run",
    "deploy": "vitest run && vite build --mode public && gh-pages -d dist --nojekyll"
  },
  "dependencies": {
    "@bartor-net/ui-kit": "^0.1.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
